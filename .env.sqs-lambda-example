# ===== AWS SQS + Lambda Configuration Example =====
# Copy relevant sections to your .env file to enable AWS SQS + Lambda processing

# ===== Feature Flag =====
# Set to 'true' to use AWS SQS + Lambda instead of local background workers
# Set to 'false' or omit to use local background workers (default)
AWS_USE_SQS_LAMBDA=false

# ===== AWS Credentials =====
# Required only when AWS_USE_SQS_LAMBDA=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ===== AWS SQS Queue =====
# SQS queue URL for story generation jobs
# Format: https://sqs.{region}.amazonaws.com/{account-id}/{queue-name}
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/story-generation-queue

# ===== AWS Lambda Function =====
# Lambda function name for story generation worker
AWS_LAMBDA_FUNCTION_NAME=story-generation-worker

# ===== Example Configurations =====

# --- Development (Local Workers) ---
# AWS_USE_SQS_LAMBDA=false
# (No AWS credentials needed)

# --- Development (SQS + Lambda Testing) ---
# AWS_USE_SQS_LAMBDA=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_dev_key
# AWS_SECRET_ACCESS_KEY=your_dev_secret
# AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/story-generation-dev-queue

# --- Production (SQS + Lambda) ---
# AWS_USE_SQS_LAMBDA=true
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_prod_key
# AWS_SECRET_ACCESS_KEY=your_prod_secret
# AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/story-generation-prod-queue

# ===== Security Best Practices =====
# 1. Use IAM roles instead of access keys when running on EC2/ECS
# 2. Store secrets in AWS Secrets Manager or Parameter Store
# 3. Use separate queues for dev/staging/production
# 4. Enable SQS encryption at rest
# 5. Use least-privilege IAM policies
# 6. Rotate credentials regularly

# ===== Monitoring =====
# Enable CloudWatch logging for Lambda
# Set up alarms for:
# - Lambda errors
# - Lambda duration > 800s
# - SQS queue depth > 100
# - Dead-letter queue messages > 0

# ===== Cost Optimization =====
# - Use reserved concurrency to limit Lambda executions
# - Set appropriate Lambda memory (3008 MB recommended)
# - Configure SQS message retention (4 days recommended)
# - Monitor costs with AWS Cost Explorer
# - Set billing alarms

